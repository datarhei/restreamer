@@ -1459,12 +1466,34 @@ static int create_master_playlist(AVFormatContext *s,
         if (final) {
             bandwidth = vs->max_bitrate;
             avg_bandwidth = vs->avg_bitrate;
+            if (avg_bandwidth < 0) {
