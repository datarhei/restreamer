+                avg_bandwidth = (int)round((double)vs->bytes_written / (av_q2d(AV_TIME_BASE_Q) * (vs->scaled_cur_pts - vs->scaled_start_pts)) * 8);
+                if (avg_bandwidth < 0) {
+                    avg_bandwidth = 0;
+                }
+
+                vs->max_bandwidth = 0.95 * vs->max_bandwidth;
+                if (avg_bandwidth > vs->max_bandwidth) {
+                    vs->max_bandwidth = avg_bandwidth;
+                }
+                bandwidth = vs->max_bandwidth;
+
+                // Reset counters
+                vs->bytes_written = 0;
+                vs->scaled_start_pts = vs->scaled_cur_pts;
+            }
+
             bandwidth += bandwidth / 10;
         }
 
