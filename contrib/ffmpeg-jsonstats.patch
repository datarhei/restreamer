diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..ea5b1c16
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,190 @@
+#!/bin/sh
+
+RED="\033[1;31m"
+GREEN="\033[1;32m"
+NOCOLOR="\033[0m"
+
+if [ $# -ne 2 ]; then
+    echo "${RED}missing parameter: ${0} ffmpeg_left ffmpeg_right${NOCOLOR}"
+    exit 1
+fi
+
+left=$1
+right=$2
+
+if [ ! -x $left -o -d $left ]; then
+    echo "${RED}ffmpeg_left is not executable or is not a file${NOCOLOR}"
+    exit 1
+fi
+
+if [ ! -x $right -o -d $right ]; then
+    echo "${RED}ffmpeg_right is not executable or is not a file${NOCOLOR}"
+    exit 1
+fi
+
+# Generate sample files
+ffmpeg -hide_banner -loglevel quiet -y -f lavfi -i testsrc2=rate=25:size=640x360 -map 0:0 -codec:v libx264 -preset:v ultrafast -r 25 -pix_fmt yuv420p -g 50 -f mp4 -t 10 example_noaudio.mp4
+ffmpeg -hide_banner -loglevel quiet -y -f lavfi -i testsrc2=rate=25:size=640x360 -f lavfi -i anullsrc=r=44100:cl=stereo -map 0:0 -map 1:0 -codec:v libx264 -preset:v ultrafast -r 25 -pix_fmt yuv420p -g 50 -codec:a aac -f mp4 -t 10 example_audio.mp4
+ffmpeg -hide_banner -loglevel quiet -y -f lavfi -i testsrc2=rate=25:size=640x360 -map 0:0 -vframes 1 -f image2 -update 1 example.jpg
+
+test=1
+
